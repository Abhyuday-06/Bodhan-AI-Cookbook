# Bodhan API credentials (get from https://console.bodhan.ai)
BODHAN_API_KEY=your_bodhan_api_key_here

# Specific Bodhan keys (optional overrides for per-model console keys)
BODHAN_TRANSLATE_KEY=your_translate_key_here
BODHAN_SPEAK_KEY=your_speak_key_here
BODHAN_TRANSCRIBE_KEY=your_transcribe_key_here
BODHAN_API_BASE=https://api.bodhan.ai

# LLM Judge configuration (OpenAI-compatible endpoint)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_API_KEY=your_llm_api_key_here
